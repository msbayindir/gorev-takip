generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ActivityType {
  CREATED
  COMMENT
  STATUS
  ASSIGNEE
  DUE_DATE
  TITLE
  DESCRIPTION
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  color        String   @default("#3A5BA9")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdTasks  Task[]         @relation("TaskCreator")
  assignments   TaskAssignee[]
  activities    Activity[]

  @@map("users")
}

model Task {
  id          String     @id @default(cuid())
  number      Int        @unique @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?  @db.Date
  creatorId   String
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  assignees  TaskAssignee[]
  activities Activity[]

  @@index([creatorId, status])
  @@map("tasks")
}

/// Görevi yapan kişiler. Bir görev birden fazla kişiye verilebilir; durum hepsi için ortaktır.
model TaskAssignee {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model Activity {
  id        String       @id @default(cuid())
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  type      ActivityType
  message   String?
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
  @@map("activities")
}
